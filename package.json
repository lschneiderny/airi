{
  "name": "@proj-airi/root",
  "type": "module",
  "version": "0.15.4",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "LLM powered virtual character",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "pnpm exec simple-git-hooks && pnpm run build:packages",
    "dev": "node scripts/dev.mjs apps/stage-tamagotchi dev",
    "dev:ui": "node scripts/dev.mjs packages/stage-ui story:dev",
    "dev:backend": "docker compose -f server/docker-compose.yaml up --build",
    "dev:server": "node scripts/dev.mjs packages/server-runtime dev",
    "dev:tamagotchi": "node scripts/dev.mjs apps/stage-tamagotchi dev",
    "dev:tamagotchi:xwayland": "node scripts/dev.mjs apps/stage-tamagotchi dev:xwayland",
    "build": "turbo run build -F=\"./packages/*\" -F=\"./apps/*\" -F=\"./server/**\"",
    "build:tamagotchi": "pnpm -F @proj-airi/stage-tamagotchi build",
    "build:packages": "turbo run build -F=\"./packages/*\" -F=\"@proj-airi/stage-tamagotchi^...\"",
    "build:engines": "turbo run build -F=\"./engines/*\"",
    "check:bundle": "pnpm build:tamagotchi && tsx scripts/dev-tools/bundle-check.ts",
    "lab:character": "node --import tsx packages/lab-tools/src/character-state/main.ts",
    "lab:model": "node --import tsx packages/lab-tools/bin/model.ts",
    "lab:motion3d": "node --import tsx packages/lab-tools/bin/motion3d.ts",
    "qa:doctor": "node --import tsx packages/qa-tools/bin/doctor.ts",
    "qa:llm": "node --import tsx packages/qa-tools/bin/llm.ts",
    "qa:app": "node --import tsx packages/qa-tools/bin/app.ts",
    "qa:bench": "node --import tsx packages/qa-tools/bin/bench.ts",
    "qa:mcp": "node --import tsx packages/qa-tools/bin/mcp.ts",
    "qa:live2d-rig": "node --import tsx packages/qa-tools/bin/live2d-rig.ts",
    "qa:motion3d": "node --import tsx packages/qa-tools/bin/motion3d.ts",
    "qa:host": "node --import tsx packages/qa-tools/bin/host.ts",
    "qa:setup": "node --import tsx packages/qa-tools/bin/setup.ts",
    "qa:smoke": "node --import tsx packages/qa-tools/bin/smoke.ts",
    "perf": "node --import tsx packages/qa-tools/bin/perf.ts",
    "perf:track": "node --import tsx packages/qa-tools/bin/track.ts",
    "qa:stage": "node --import tsx packages/qa-tools/bin/stage.ts",
    "qa:test:model": "tsx scripts/dev-tools/qa-test-model.ts",
    "test": "vitest --coverage",
    "test:run": "tsx scripts/dev-tools/test-run.ts",
    "test:root": "vitest run",
    "lint": "moeru-lint .",
    "lint:fix": "moeru-lint --fix .",
    "lint:prune-suppressions": "eslint . --prune-suppressions",
    "i18n:check": "x18n check",
    "capture:tamagotchi": "pnpm exec vishot capture --target electron ./packages/scenarios-stage-tamagotchi-electron/src/scenarios/demo-controls-settings-chat-websocket/index.ts --app-entrypoint ./apps/stage-tamagotchi/out/main/index.js --cwd . --output-dir ./packages/scenarios-stage-tamagotchi-browser/artifacts/raw --format avif",
    "typecheck": "turbo run typecheck -F=\"./packages/*\" -F=\"./apps/*\" -F=\"./server/**\" -F=\"./services/*\"",
    "typecheck:engines": "pnpm -rF=\"./engines/*\" --parallel typecheck",
    "verify": "tsx scripts/dev-tools/verify.ts",
    "wt": "tsx scripts/dev-tools/wt.ts",
    "release": "tsx scripts/dev-tools/release.ts",
    "dev:top": "tsx scripts/dev-tools/top.ts",
    "qa:display": "tsx scripts/dev-tools/qa-display.ts",
    "qa:kwin-probe": "tsx scripts/dev-tools/kwin-probe.ts",
    "deps:up": "taze -w -r -I && pnpm prune && pnpm dedupe",
    "knip": "knip"
  },
  "devDependencies": {
    "@alint-js/cli": "catalog:",
    "@alint-js/plugin-js": "catalog:",
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/core": "catalog:",
    "@electron-toolkit/eslint-config-ts": "catalog:",
    "@iconify/utils": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@moeru/std": "catalog:",
    "@proj-airi/unocss-preset-chromatic": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-mini": "catalog:",
    "@unocss/preset-web-fonts": "catalog:",
    "@vishot/cli": "catalog:",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-v8": "catalog:vitest",
    "@x18n/cli": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "oxc-minify": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "rollup": "catalog:",
    "simple-git-hooks": "catalog:",
    "taze": "catalog:",
    "tinyexec": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "uncrypto": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "unplugin-lightningcss": "catalog:",
    "unplugin-raw": "catalog:",
    "unplugin-unused": "catalog:",
    "vite": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vitest": "catalog:vitest",
    "vitest-browser-vue": "catalog:",
    "yaml": "catalog:"
  },
  "workspaces": [
    "packages/**",
    "plugins/**",
    "integrations/**",
    "services/**",
    "examples/**",
    "engines/**",
    "apps/**",
    "server/**"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  }
}
