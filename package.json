{
  "name": "@proj-airi/root",
  "type": "module",
  "version": "0.12.0-beta.5",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "LLM powered virtual character",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "pnpm exec simple-git-hooks && pnpm run build:packages",
    "dev": "node scripts/dev.mjs apps/stage-web dev",
    "dev:ui": "node scripts/dev.mjs packages/stage-ui story:dev",
    "dev:web": "node scripts/dev.mjs apps/stage-web dev",
    "dev:web:https": "node scripts/dev.mjs apps/stage-web dev:https",
    "dev:server-auth": "node scripts/dev.mjs apps/ui-server-auth dev",
    "dev:backend": "docker compose -f server/docker-compose.yaml up --build",
    "dev:pocket:ios": "pnpm -rF @proj-airi/stage-pocket run dev:ios",
    "dev:pocket:android": "pnpm -rF @proj-airi/stage-pocket run dev:android",
    "dev:server": "node scripts/dev.mjs packages/server-runtime dev",
    "dev:tamagotchi": "node scripts/dev.mjs apps/stage-tamagotchi dev",
    "dev:tamagotchi:xwayland": "node scripts/dev.mjs apps/stage-tamagotchi dev:xwayland",
    "dev:apps": "pnpm -rF=\"./apps/*\" run --parallel dev",
    "dev:packages": "pnpm -rF=\"./packages/*\" --parallel run dev",
    "build": "tsx packages/cpu-slots/src/cli.ts run --class build -- turbo run build -F=\"./packages/*\" -F=\"./apps/*\" -F=\"./server/**\" \"--concurrency={grant}\"",
    "build:web": "tsx packages/cpu-slots/src/cli.ts run --class build -- turbo run build -F @proj-airi/stage-web \"--concurrency={grant}\"",
    "build:tamagotchi": "tsx packages/cpu-slots/src/cli.ts run --class build -- pnpm -rF @proj-airi/stage-tamagotchi run app:build",
    "build:apps": "tsx packages/cpu-slots/src/cli.ts run --class build -- turbo run build -F=\"./apps/*\" \"--concurrency={grant}\"",
    "build:packages": "tsx packages/cpu-slots/src/cli.ts run --class build -- turbo run build -F=\"./packages/*\" \"--concurrency={grant}\"",
    "build:engines": "tsx packages/cpu-slots/src/cli.ts run --class build -- turbo run build -F=\"./engines/*\" \"--concurrency={grant}\"",
    "qa:doctor": "pnpm -F @proj-airi/qa-tools run doctor",
    "qa:motion": "pnpm -F @proj-airi/qa-tools run motion",
    "qa:report": "pnpm -F @proj-airi/qa-tools run report",
    "qa:test": "pnpm -F @proj-airi/qa-tools run test:qa",
    "test": "vitest --coverage",
    "test:run": "vitest run && pnpm run test-stage-tamagotchi:run && pnpm run test-stage-web:run && pnpm run test-stage-pages:run && pnpm run test-ui:run && pnpm run test-stage-ui-live2d:run",
    "test-stage-pages:run": "pnpm -F @proj-airi/stage-pages test:run",
    "test-stage-web:run": "pnpm -F @proj-airi/stage-web exec vitest run --project browser src/pages/devtools/vrm-model-position.browser.test.ts",
    "test-stage-tamagotchi:run": "vitest run --config apps/stage-tamagotchi/vitest.config.ts --project browser",
    "test-ui:run": "vitest run --config packages/stage-ui/vitest.config.ts",
    "test-stage-ui-live2d:run": "vitest run --config packages/stage-ui-live2d/vitest.config.ts --project browser",
    "lint": "moeru-lint .",
    "lint:fix": "moeru-lint --fix .",
    "lint:swift": "pnpm -rF @proj-airi/stage-pocket run lint:swift",
    "capture:tamagotchi": "tsx packages/cpu-slots/src/cli.ts run --class exclusive -- pnpm exec vishot capture --target electron ./packages/scenarios-stage-tamagotchi-electron/src/scenarios/demo-controls-settings-chat-websocket/index.ts --app-entrypoint ./apps/stage-tamagotchi/out/main/index.js --cwd . --output-dir ./packages/scenarios-stage-tamagotchi-browser/artifacts/raw --format avif",
    "sponsors:generate": "sponsorkit --output-dir docs/assets/sponsors",
    "typecheck": "tsx packages/cpu-slots/src/cli.ts run --class typecheck -- turbo run typecheck -F=\"./packages/*\" -F=\"./apps/*\" -F=\"./server/**\" -F=\"./services/*\" \"--concurrency={grant}\"",
    "typecheck:engines": "tsx packages/cpu-slots/src/cli.ts run --class build -- pnpm -rF=\"./engines/*\" --parallel typecheck",
    "slots": "tsx packages/cpu-slots/src/cli.ts",
    "verify": "tsx scripts/dev-tools/verify.ts",
    "wt": "tsx scripts/dev-tools/wt.ts",
    "dev:top": "tsx scripts/dev-tools/top.ts",
    "up": "taze -w -r -I && pnpm prune && pnpm dedupe",
    "nolyfill": "pnpm dlx nolyfill",
    "open:ios": "pnpm -rF @proj-airi/stage-pocket run open:ios",
    "knip": "knip"
  },
  "devDependencies": {
    "@alint-js/cli": "catalog:",
    "@alint-js/plugin-js": "catalog:",
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/core": "catalog:",
    "@electron-toolkit/eslint-config-ts": "catalog:",
    "@iconify/utils": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@moeru/std": "catalog:",
    "@proj-airi/cpu-slots": "workspace:^",
    "@proj-airi/unocss-preset-chromatic": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-mini": "catalog:",
    "@unocss/preset-web-fonts": "catalog:",
    "@vishot/cli": "catalog:",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-v8": "catalog:vitest",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "oxc-minify": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "rollup": "catalog:",
    "simple-git-hooks": "catalog:",
    "sponsorkit": "catalog:",
    "sponsors-svg": "catalog:",
    "taze": "catalog:",
    "tinyexec": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "uncrypto": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "unplugin-lightningcss": "catalog:",
    "unplugin-raw": "catalog:",
    "unplugin-unused": "catalog:",
    "vite": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vitest": "catalog:vitest",
    "vitest-browser-vue": "catalog:",
    "yaml": "catalog:"
  },
  "workspaces": [
    "packages/**",
    "plugins/**",
    "integrations/**",
    "services/**",
    "examples/**",
    "engines/**",
    "apps/**",
    "server/**"
  ],
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "moeru-lint --fix"
  }
}
