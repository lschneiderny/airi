{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputLogs": "errors-only"
    },
    "@proj-airi/api-server#typecheck": {
      "dependsOn": ["transit", "@proj-airi/server-sdk-shared#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputLogs": "errors-only"
    },
    "test:run": {
      "dependsOn": ["^build"],
      "env": ["CI", "NODE_OPTIONS", "TESTING_AUDIO_*"],
      "passThroughEnv": ["NODE_COMPILE_CACHE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*",
        "!$TURBO_ROOT$/.env.qa",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/uno.config.ts",
        "$TURBO_ROOT$/vitest.dom-storage.ts",
        "$TURBO_ROOT$/scripts/dev-tools/vitest-isolate-host-session.ts"
      ]
    },
    "@proj-airi/stage-ui#test:run": {
      "dependsOn": ["^build"],
      "env": ["CI", "NODE_OPTIONS", "TESTING_AUDIO_*", "XDG_CURRENT_DESKTOP"],
      "passThroughEnv": ["NODE_COMPILE_CACHE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*",
        "!$TURBO_ROOT$/.env.qa",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/uno.config.ts",
        "$TURBO_ROOT$/vitest.dom-storage.ts",
        "$TURBO_ROOT$/scripts/dev-tools/vitest-isolate-host-session.ts",
        "$TURBO_ROOT$/packages/stage-pages/src/**",
        "$TURBO_ROOT$/packages/lab-tools/fixtures/model/*.json"
      ]
    },
    "@proj-airi/qa-tools#test:run": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "CI",
        "NODE_OPTIONS",
        "TESTING_AUDIO_*"
      ],
      "passThroughEnv": [
        "NODE_COMPILE_CACHE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*",
        "!$TURBO_ROOT$/.env.qa",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/uno.config.ts",
        "$TURBO_ROOT$/vitest.dom-storage.ts",
        "$TURBO_ROOT$/scripts/dev-tools/vitest-isolate-host-session.ts",
        "$TURBO_ROOT$/packages/lab-tools/model-eval/sets/legacy-2026-10-27-mac-m2/transcripts.jsonl"
      ]
    },
    "@proj-airi/i18n#test:run": {
      "dependsOn": ["^build"],
      "env": ["CI", "NODE_OPTIONS", "TESTING_AUDIO_*"],
      "passThroughEnv": ["NODE_COMPILE_CACHE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*",
        "!$TURBO_ROOT$/.env.qa",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/uno.config.ts",
        "$TURBO_ROOT$/vitest.dom-storage.ts",
        "$TURBO_ROOT$/scripts/dev-tools/vitest-isolate-host-session.ts",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/**/*.md"
      ]
    },
    "@proj-airi/electron-vueuse#build": {
      "dependsOn": ["@proj-airi/electron-eventa#build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@proj-airi/api-server#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@proj-airi/auth-server#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@proj-airi/stage-tamagotchi#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"],
      "outputLogs": "errors-only"
    },
    "@proj-airi/stage-ui#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@proj-airi/electron-native-backdrop#build": {
      "cache": false,
      "outputs": ["dist/**"]
    }
  }
}
