{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@proj-airi/cpu-slots#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsdown.config.ts", "package.json", "tsconfig.json", "$TURBO_ROOT$/tsconfig.json"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "@proj-airi/cpu-slots#build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputLogs": "errors-only"
    },
    "@proj-airi/electron-vueuse#build": {
      "dependsOn": ["@proj-airi/electron-eventa#build"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "@proj-airi/api-server#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@proj-airi/auth-server#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "@proj-airi/stage-tamagotchi#build": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"],
      "outputLogs": "errors-only"
    },
    "@proj-airi/stage-ui#build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "errors-only"
    }
  }
}
