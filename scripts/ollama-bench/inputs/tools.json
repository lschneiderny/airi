            "enum": [
              "face",
              "effect",
              "prop"
            ]
          }
        },
        "additionalProperties": false
      },
      "strict": true
    }
  },
  {
    "type": "function",
    "function": {
      "description": "List the exposed expression labels with their kind and whether each is shown now.",
      "name": "list_expressions",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
