  {
    "type": "function",
    "function": {
      "description": "Show one of the character's exposed expressions (faces, effects, props, or combos, which show several expressions together) by label. Without hold_seconds it lasts while the current reply is spoken.",
      "name": "set_expression",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "expression": {
            "type": "string",
            "enum": [
              "anger",
              "box",
              "cry",
              "Drum mouth",
              "eat eat",
              "eat",
              "game",
              "love",
              "mouse",
              "no mouse",
              "Pen fingers",
              "pillow",
              "red",
              "Snot bubbles",
              "Sticky note",
              "background"
            ],
            "description": "Label of an exposed expression."
          },
          "hold_seconds": {
            "description": "Seconds to keep it shown, from 1 to 30. Omit to follow speech.",
            "type": "number",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "expression"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
  },
  {
