@@ -27,6 +27,32 @@ const DIFF_ARGS = [
   '--submodule=short',
 ]
 
+// Windows rejects command lines over 32767 characters, so long path lists run as several git commands.
+const MAX_PATHS_LENGTH = 24_000
+
+function chunkPaths(paths) {
+  const chunks = []
+  let current = []
+  let length = 0
+
+  for (const path of paths) {
+    if (current.length && length + path.length + 1 > MAX_PATHS_LENGTH) {
+      chunks.push(current)
+      current = []
+      length = 0
+    }
+
+    current.push(path)
+    length += path.length + 1
+  }
+
+  if (current.length) {
+    chunks.push(current)
+  }
+
+  return chunks
+}
